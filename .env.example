# Sentinel configuration. Copy to .env and edit. NEVER commit the real .env.
# Every value below has a safe default, so the app runs with an empty .env too.

# --- Server ---
# Interface to bind. 0.0.0.0 exposes the app on your network; use 127.0.0.1 locally.
HOST=0.0.0.0
# HTTP port.
PORT=8000
# debug | info | warning | error | critical. Keep debug off in production.
LOG_LEVEL=INFO

# --- Safety toggles ---
# DEMO_MODE exposes the audit-tamper endpoint. Turn OFF for anything not a demo.
DEMO_MODE=true
# Drop and recreate the database on startup. Local development only.
RESET_DB_ON_START=false
# Longest accepted customer message, in characters.
MAX_MESSAGE_CHARS=4000

# --- Authentication ---
# Require login for all data endpoints. Must stay true outside demo mode.
AUTH_ENABLED=true
# Signing key for bearer tokens. REQUIRED when DEMO_MODE=false. Use 32+ random bytes:
#   python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=
# Token lifetime in seconds (default 12 hours).
TOKEN_TTL_SECONDS=43200

# --- Rate limiting (sliding window) ---
# Login/register attempts per window, per IP and per email.
RATE_LIMIT_AUTH=10
RATE_LIMIT_AUTH_WINDOW=900
# General API requests per window, per IP.
RATE_LIMIT_API=300
RATE_LIMIT_API_WINDOW=60
# Only enable behind a proxy that overwrites X-Forwarded-For; otherwise a
# client could spoof its IP to bypass limits.
TRUST_PROXY_HEADERS=false

# --- Optional LLM intent refinement (disabled unless both are set) ---
LLM_ENABLED=false
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=8

# --- Database (optional override) ---
# Absolute path to the SQLite file. Defaults to backend/sentinel.db.
DB_PATH=
